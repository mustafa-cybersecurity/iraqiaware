{
  "providers": [
    {
      "name": "openai",
      "display_name": "OpenAI GPT-4 Vision",
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "requires_fields": ["api_key", "model"],
      "models": [
        "gpt-4o",
        "gpt-4-vision-preview",
        "gpt-4-turbo"
      ],
      "notes": "Requires an OpenAI API key with vision capabilities enabled."
    },
    {
      "name": "google",
      "display_name": "Google Cloud Vision",
      "endpoint": "https://vision.googleapis.com/v1/images:annotate",
      "requires_fields": ["api_key"],
      "models": ["default"],
      "notes": "Requires a Google Cloud project with the Vision API enabled."
    }
  ]
}
