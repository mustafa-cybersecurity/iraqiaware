/* ============================================================
   IraqiAware – Dark Theme Stylesheet (Catppuccin Mocha-inspired)
   ============================================================ */

/* ── Global ──────────────────────────────────────────────────── */
* {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
    color: #cdd6f4;
}

QMainWindow, QDialog, QWidget {
    background-color: #1e1e2e;
}

/* ── Navigation Panel ────────────────────────────────────────── */
#navPanel {
    background-color: #181825;
    border-right: 1px solid #313244;
}

#logoLabel {
    font-size: 18px;
    font-weight: bold;
    color: #89b4fa;
    padding: 8px 0;
}

#subLabel {
    font-size: 11px;
    color: #6c7086;
    margin-bottom: 8px;
}

#navButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    text-align: left;
    font-size: 13px;
    color: #cdd6f4;
}

#navButton:hover {
    background-color: #313244;
}

#navButton:checked {
    background-color: #313244;
    border-left: 3px solid #89b4fa;
    color: #89b4fa;
    font-weight: bold;
}

/* ── Toggle Monitoring Button ────────────────────────────────── */
#toggleButton {
    background-color: #a6e3a1;
    color: #1e1e2e;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
}

#toggleButton:hover {
    background-color: #94e2d5;
}

#toggleButton[active="true"] {
    background-color: #f38ba8;
    color: #1e1e2e;
}

#toggleButton[active="true"]:hover {
    background-color: #eba0ac;
}

/* ── Content Stack ───────────────────────────────────────────── */
#contentStack {
    background-color: #1e1e2e;
}

/* ── Page Title ──────────────────────────────────────────────── */
#pageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #cdd6f4;
    padding-bottom: 8px;
    border-bottom: 1px solid #313244;
    margin-bottom: 8px;
}

/* ── Stat Cards ──────────────────────────────────────────────── */
#statCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    min-width: 140px;
}

#statLabel {
    font-size: 11px;
    color: #6c7086;
    margin-bottom: 4px;
}

#statValue {
    font-size: 22px;
    font-weight: bold;
    color: #89b4fa;
}

/* ── Group Boxes ─────────────────────────────────────────────── */
#contentGroup {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 12px;
}

QGroupBox {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #89b4fa;
    font-weight: bold;
}

/* ── Buttons ─────────────────────────────────────────────────── */
QPushButton {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 16px;
    color: #cdd6f4;
}

QPushButton:hover {
    background-color: #45475a;
    border-color: #585b70;
}

QPushButton:pressed {
    background-color: #585b70;
}

#primaryButton {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    font-weight: bold;
}

#primaryButton:hover {
    background-color: #74c7ec;
}

#toolButton {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 12px;
}

/* ── Input fields ────────────────────────────────────────────── */
QLineEdit, QTextEdit, QSpinBox, QComboBox {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 5px;
    padding: 5px 8px;
    color: #cdd6f4;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #89b4fa;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #cdd6f4;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #313244;
    border: 1px solid #45475a;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
    outline: none;
}

/* ── Table ───────────────────────────────────────────────────── */
#alertsTable {
    background-color: #181825;
    gridline-color: #313244;
    border: 1px solid #313244;
    border-radius: 6px;
    alternate-background-color: #1e1e2e;
}

QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #313244;
}

QTableWidget::item:selected {
    background-color: #313244;
    color: #cdd6f4;
}

QHeaderView::section {
    background-color: #181825;
    color: #89b4fa;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #313244;
    font-weight: bold;
}

/* ── Log output ──────────────────────────────────────────────── */
#logOutput {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    color: #cdd6f4;
    padding: 8px;
}

/* ── Scroll bars ─────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #181825;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #585b70;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: #181825;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #45475a;
    border-radius: 5px;
    min-width: 24px;
}

/* ── Status bar ──────────────────────────────────────────────── */
QStatusBar {
    background-color: #181825;
    color: #6c7086;
    border-top: 1px solid #313244;
    font-size: 11px;
}

/* ── Checkboxes ──────────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    color: #cdd6f4;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #45475a;
    border-radius: 3px;
    background: #313244;
}

QCheckBox::indicator:checked {
    background-color: #89b4fa;
    border-color: #89b4fa;
}

/* ── Tool Tips ───────────────────────────────────────────────── */
QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ── Message boxes ───────────────────────────────────────────── */
QMessageBox {
    background-color: #1e1e2e;
}

QMessageBox QLabel {
    color: #cdd6f4;
}

/* ── Labels ──────────────────────────────────────────────────── */
QLabel {
    color: #cdd6f4;
}
